# ==============================================================================
# LawCompass BACKEND CONFIGURATION (.env)
# ==============================================================================
# CONFIDENTIAL: NEVER COMMIT THIS FILE OR EXPOSE TO PUBLIC FRONTEND
# ==============================================================================

NODE_ENV=development
PORT=3000

# Client Origins allowed through CORS (comma separated)
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Supabase Project URL (REST API endpoint)
SUPABASE_URL=https://your-project.supabase.co

# Supabase Public Anon Key (for public / scoped access)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (PRIVILEGED - BACKEND ONLY!)
# Bypasses Row Level Security (RLS) for background workers, billing & admin
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# PostgreSQL Direct Connection String (Used for migrations & direct pooling)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.your-project.supabase.co:5432/postgres

# JWT Secret from Supabase Settings -> API -> JWT Settings
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ------------------------------------------------------------------------------
# OBJECT STORAGE & FILE RETENTION
# ------------------------------------------------------------------------------
# Private bucket for documents and uploads (never public)
SUPABASE_STORAGE_BUCKET=contracts
SIGNED_URL_EXPIRY_SECONDS=900

# ------------------------------------------------------------------------------
# PAYMENT GATEWAY (Paystack for South Africa / ZAR)
# ------------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# AI CONTRACT READER (Sandboxed Backend Extraction)
# ------------------------------------------------------------------------------
AI_PROVIDER=openai
AI_API_KEY=sk-placeholder
AI_MODEL=gpt-4o-mini

