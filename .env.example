# ==============================================================================
# LawCompass ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# IMPORTANT ARCHITECTURAL RULE:
# NEVER expose backend secrets (SERVICE_ROLE_KEY, DATABASE_URL, WEBHOOK_SECRET)
# in frontend client bundles. Frontend code should only ever receive PUBLIC keys!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CLIENT KEYS (Safe for frontend & public APIs)
# ------------------------------------------------------------------------------
# Your Supabase Project REST Endpoint (found in Supabase Settings -> API)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Public Anon Key: Safe for browser consumption.
# Requests with this key are strictly restricted by Supabase Row Level Security (RLS).
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inh4eHh4eHh4eHh4eHh4eHh4eHh4Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3Mjk3NjA4MDAsImV4cCI6MjA0NTMzNjgwMH0.placeholder_anon_key

# ------------------------------------------------------------------------------
# 2. SUPABASE BACKEND PRIVILEGED KEYS (CRITICAL - BACKEND SERVER ONLY!)
# ------------------------------------------------------------------------------
# WARNING: The Service Role Key BYPASSES ALL ROW LEVEL SECURITY (RLS) policies!
# It grants unrestricted admin read/write access to your entire database.
# NEVER expose this key in client-side JavaScript, GitHub, or public endpoints.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inh4eHh4eHh4eHh4eHh4eHh4eHh4Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTcyOTc2MDgwMCwiZXhwIjoyMDQ1MzM2ODAwfQ.placeholder_service_role_key

# JWT Secret used by your backend application server to sign and verify user session tokens
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-from-api-settings

# Direct PostgreSQL Database Connection String (Used for Prisma, Drizzle, or Migrations)
# Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# ------------------------------------------------------------------------------
# 3. SECURE OBJECT STORAGE (Private Buckets)
# ------------------------------------------------------------------------------
# Storage bucket name for sensitive user contracts and generated DOCX/PDF files.
# MUST BE MARKED AS "PRIVATE" (never public). Access only via signed temporary URLs.
SUPABASE_STORAGE_BUCKET=contracts
SIGNED_URL_EXPIRY_SECONDS=900

# ------------------------------------------------------------------------------
# 4. PAYMENT & SUBSCRIPTION GATEWAY (PCI Compliant, Webhook-Driven)
# ------------------------------------------------------------------------------
# Paystack / Stripe credentials for South African Rand (ZAR) transactions
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 5. AI CONTRACT EXPLAINER & OCR (Isolated Backend Workers)
# ------------------------------------------------------------------------------
# AI Provider key for plain-English clause extraction and analysis
AI_PROVIDER=openai # openai | gemini | anthropic
AI_API_KEY=sk-placeholder-ai-key-for-backend-use-only
AI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your-gemini-api-key-for-backend-use-only

# ------------------------------------------------------------------------------
# 6. APPLICATION SERVER & SECURITY HEADERS
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,https://app.LawCompass.co.za
COOKIE_SECRET=your_random_32_character_cookie_secret_string
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

